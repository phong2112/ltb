# Public API hostname only. Do not include https:// or a path.
API_DOMAIN=api.example.com

NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://your-production-web-domain.com
WEB_ORIGINS=https://your-production-web-domain.com,https://your-project-*-your-team.vercel.app

# Use the Neon pooled URL at runtime and the direct URL for migrations.
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=require
MIGRATION_DATABASE_URL=postgresql://<user>:<password>@<direct-host>/<database>?sslmode=require

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME="Lường Bích"

JWT_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL_SECONDS=28800
JWT_REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none

CV_STORAGE_DRIVER=r2
CV_ARCHIVE_STORAGE_DRIVER=vercel-blob
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=<bucket-name>
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
BLOB_READ_WRITE_TOKEN=<vercel-blob-read-write-token>
MAX_CV_FILE_SIZE_MB=10

# Copy the managed Redis and private Ollama values from the current service.
# Set AI_PROVIDER=disabled for the first smoke test if those services are not ready.
AI_PROVIDER=ollama
REDIS_URL=rediss://<managed-redis-url>
OLLAMA_BASE_URL=https://<private-ollama-service>
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=300000
OLLAMA_CONTEXT_LENGTH=16384
AI_JOB_ATTEMPTS=2
CV_EXTRACTION_CONCURRENCY=1
AI_MATCH_CONCURRENCY=1
OCR_MAX_PAGES=10
OCR_MIN_CONFIDENCE=55
OCR_TIMEOUT_MS=120000

APPLICATION_RATE_LIMIT_MAX=5
APPLICATION_RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false

# Gmail API over HTTPS (OAuth2) — see docs/gmail-api-email-setup.md
EMAIL_PROVIDER=gmail
EMAIL_FROM="Lường Bích <your-gmail-address@gmail.com>"
EMAIL_REPLY_TO=your-gmail-address@gmail.com
GMAIL_CLIENT_ID=<oauth2-client-id>.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=<oauth2-client-secret>
GMAIL_REFRESH_TOKEN=<oauth2-refresh-token>
