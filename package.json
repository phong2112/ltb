{
  "name": "hr-copilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @hr-copilot/db prisma generate",
    "db:migrate": "pnpm --filter @hr-copilot/db prisma migrate dev",
    "db:deploy": "pnpm --filter @hr-copilot/db prisma migrate deploy",
    "db:seed": "pnpm --filter @hr-copilot/db seed",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^2.0.5",
      "brace-expansion@1": "^1.1.17",
      "brace-expansion@2": "^2.1.3",
      "brace-expansion@5": "^5.0.8",
      "esbuild": "0.25.12",
      "fast-uri": "^3.1.4",
      "postcss": "^8.5.18",
      "tar": "^7.5.21",
      "valibot": "^1.4.2"
    }
  }
}
