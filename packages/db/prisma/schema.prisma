generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  NEW
  VIEWED
  CONTACTED
  REPLIED
  INTERVIEW
  OFFER
  OFFER_CLOSED
  REJECTED
  TALENT_POOL
}

enum FileKind {
  CV
  OTHER
}

enum FileStorageTier {
  PRIMARY
  ARCHIVE
}

enum CvParseStatus {
  PENDING
  EXTRACTING
  EXTRACTED
  ANALYZING
  COMPLETED
  FAILED
}

enum TalentPoolSource {
  TA_UPLOAD
}

enum SourcingCampaignStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum SourcingProfileStatus {
  SOURCED
  QUALIFIED
  CONTACT_READY
  CONTACTED
  REPLIED
  INTERESTED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  NOT_A_FIT
}

enum SourcingSource {
  LINKEDIN
  TALENT_POOL
  GITHUB
  PUBLIC_WEB
  FACEBOOK
  ITVIEC
  VIETNAMWORKS
  ZALO
  GITLAB
  STACK_OVERFLOW
  MANUAL
  CSV
  REFERRAL
}

enum SourcingDiscoveryLocationScope {
  VIETNAM
  GLOBAL
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String
  talentPoolUploads TalentPoolEntry[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Job {
  id                String             @id @default(cuid())
  title             String
  slug              String             @unique
  company           String?
  department        String?
  locations         String[]           @default([])
  employment        String?
  level             String?
  salaryRange       String?
  tags              String[]           @default([])
  description       String
  requirements      String
  benefits          String?
  status            JobStatus          @default(DRAFT)
  urgent            Boolean            @default(false)
  logo              String?
  questions         JobQuestion[]
  applications      Application[]
  activities        ActivityLog[]
  sourcingCampaigns SourcingCampaign[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SourcingCampaign {
  id                     String                         @id @default(cuid())
  jobId                  String
  name                   String
  status                 SourcingCampaignStatus         @default(ACTIVE)
  discoveryLocationScope SourcingDiscoveryLocationScope @default(VIETNAM)
  brief                  Json
  searchQueries          Json
  job                    Job                            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  profiles               SourcedProfile[]
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([discoveryLocationScope])
  @@index([createdAt])
}

model SourcedProfile {
  id                   String                @id @default(cuid())
  campaignId           String
  source               SourcingSource        @default(LINKEDIN)
  profileUrl           String
  normalizedProfileUrl String
  displayName          String?
  headline             String?
  location             String?
  notes                String?
  status               SourcingProfileStatus @default(SOURCED)
  extractionMethod     String                @default("ta_provided_url")
  fetchedAt            DateTime?
  campaign             SourcingCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([campaignId, normalizedProfileUrl])
  @@index([source, normalizedProfileUrl])
  @@index([campaignId, status])
  @@index([createdAt])
}

model JobQuestion {
  id        String   @id @default(cuid())
  jobId     String
  label     String
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
}

model Candidate {
  id                    String            @id @default(cuid())
  fullName              String
  email                 String?
  normalizedEmail       String?           @unique(map: "Candidate_normalizedEmail_unique_not_null", where: raw("(\"normalizedEmail\" IS NOT NULL)"))
  phone                 String?
  normalizedPhone       String?           @unique(map: "Candidate_normalizedPhone_unique_not_null", where: raw("(\"normalizedPhone\" IS NOT NULL)"))
  linkedinUrl           String?
  normalizedLinkedinUrl String?           @unique(map: "Candidate_normalizedLinkedinUrl_unique_not_null", where: raw("(\"normalizedLinkedinUrl\" IS NOT NULL)"))
  portfolioUrl          String?
  source                String            @default("career_site")
  applications          Application[]
  talentPoolEntries     TalentPoolEntry[]
  activities            ActivityLog[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([email])
  @@index([normalizedEmail])
  @@index([phone])
  @@index([normalizedPhone])
  @@index([normalizedLinkedinUrl])
  @@index([createdAt])
}

model Application {
  id                    String             @id @default(cuid())
  candidateId           String
  jobId                 String
  submittedFullName     String
  submittedEmail        String?
  submittedPhone        String?
  submittedLinkedinUrl  String?
  submittedPortfolioUrl String?
  /// DB invariant: Application_normalized_contact_required enforces at least one normalized contact.
  /// Prisma Client does not model check constraints, so keep the SQL migration in sync.
  normalizedEmail       String?
  normalizedPhone       String?
  normalizedLinkedinUrl String?
  status                ApplicationStatus  @default(NEW)
  salaryExpectation     String?
  noticePeriod          String?
  coverNote             String?
  hrNotes               String?
  answers               Json?
  consentAccepted       Boolean            @default(false)
  candidate             Candidate          @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  job                   Job                @relation(fields: [jobId], references: [id], onDelete: Restrict)
  files                 CandidateFile[]
  cvParseResult         CvParseResult?
  followUpTask          FollowUpTask?
  matchResult           MatchResult?
  messages              CandidateMessage[]
  activities            ActivityLog[]
  promotedFromPool      TalentPoolEntry?   @relation("PromotedFromPool")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([candidateId, jobId])
  @@unique([jobId, normalizedEmail])
  @@unique([jobId, normalizedPhone])
  @@unique([jobId, normalizedLinkedinUrl])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

model CandidateFile {
  id                String           @id @default(cuid())
  applicationId     String?
  talentPoolEntryId String?          @unique
  kind              FileKind         @default(CV)
  storageTier       FileStorageTier  @default(PRIMARY)
  originalName      String
  storedName        String
  mimeType          String
  sizeBytes         Int
  path              String
  archivedAt        DateTime?
  /// DB invariant: CandidateFile_owner_exactly_one enforces exactly one of applicationId/talentPoolEntryId.
  /// Prisma Client does not model check constraints, so keep the SQL migration in sync.
  application       Application?     @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  talentPoolEntry   TalentPoolEntry? @relation(fields: [talentPoolEntryId], references: [id], onDelete: Restrict)
  cvParseResults    CvParseResult[]
  activities        ActivityLog[]
  createdAt         DateTime         @default(now())

  @@index([applicationId])
  @@index([applicationId, kind])
  @@index([storageTier])
}

model TalentPoolEntry {
  id                    String           @id @default(cuid())
  candidateId           String
  status                CvParseStatus    @default(PENDING)
  source                TalentPoolSource @default(TA_UPLOAD)
  uploadedByUserId      String?
  summary               String?
  structuredData        Json?
  extractedText         String?
  errorMessage          String?
  tags                  String[]         @default([])
  notes                 String?
  promotedApplicationId String?          @unique
  candidate             Candidate        @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  uploadedBy            User?            @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  promotedApplication   Application?     @relation("PromotedFromPool", fields: [promotedApplicationId], references: [id], onDelete: SetNull)
  file                  CandidateFile?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([candidateId])
  @@index([status])
  @@index([createdAt])
}

model CvParseResult {
  id              String         @id @default(cuid())
  applicationId   String         @unique
  candidateFileId String?
  status          CvParseStatus  @default(PENDING)
  summary         String?
  structuredData  Json?
  extractedText   String?
  errorMessage    String?
  application     Application    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  candidateFile   CandidateFile? @relation(fields: [candidateFileId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([candidateFileId])
}

model MatchResult {
  id                  String      @id @default(cuid())
  applicationId       String      @unique
  score               Int
  strengths           Json
  risks               Json
  missingRequirements Json
  screeningQuestions  Json
  application         Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  channel   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CandidateMessage {
  id            String      @id @default(cuid())
  applicationId String
  channel       String
  direction     String
  content       String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

model FollowUpTask {
  id            String      @id @default(cuid())
  applicationId String      @unique
  title         String
  dueAt         DateTime
  completedAt   DateTime?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([dueAt])
}

model ActivityLog {
  id              String         @id @default(cuid())
  candidateId     String?
  applicationId   String?
  jobId           String?
  candidateFileId String?
  actor           String         @default("system")
  action          String
  metadata        Json?
  candidate       Candidate?     @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  application     Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  job             Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  candidateFile   CandidateFile? @relation(fields: [candidateFileId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([candidateId])
  @@index([applicationId])
  @@index([jobId])
  @@index([candidateFileId])
  @@index([createdAt])
}
