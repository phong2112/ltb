# Shared
NODE_ENV=development

# Frontend build (Vite)
VITE_API_BASE_PATH=/api
VITE_DEFAULT_TENANT_SLUG=ltb
# Optional. Enables subdomain tenant detection, e.g. ltb.example.com.
VITE_PUBLIC_ROOT_DOMAIN=
# Keep this equal to the API's MAX_CV_FILE_SIZE_MB value.
VITE_MAX_CV_FILE_SIZE_MB=10
VITE_CONTACT_EMAIL=admin@example.com
VITE_CONTACT_MESSENGER_URL=https://www.facebook.com/example
VITE_CONTACT_LINKEDIN_URL=https://www.linkedin.com/in/example/
VITE_CONTACT_PHONE_DISPLAY="+84 00 000 0000"
VITE_CONTACT_PHONE_HREF=tel:+84000000000

# API
PORT=4000
WEB_ORIGIN=http://localhost:8080
# Optional comma-separated extra allowed browser origins.
# Supports exact origins and simple host wildcards such as https://*.vercel.app.
WEB_ORIGINS=
DEFAULT_TENANT_SLUG=ltb
# Optional comma-separated public root domains, e.g. example.com,careers.example.com.
PUBLIC_ROOT_DOMAINS=
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/hr_copilot?schema=public
# Optional. Use Neon direct connection here when DATABASE_URL uses Neon pooled connection.
MIGRATION_DATABASE_URL=
REDIS_URL=redis://localhost:56379
# Used only when CV_STORAGE_DRIVER=local.
UPLOAD_DIR=/app/uploads
MAX_CV_FILE_SIZE_MB=10
APPLICATION_RATE_LIMIT_MAX=5
APPLICATION_RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=true

# LinkedIn assisted sourcing discovery
# Uses Brave Search public web results only. It does not scrape logged-in LinkedIn pages.
SOURCING_DISCOVERY_ENABLED=false
BRAVE_SEARCH_API_KEY=
SOURCING_DISCOVERY_MAX_QUERIES_PER_CAMPAIGN=12
SOURCING_DISCOVERY_RESULTS_PER_QUERY=10

# AI matching
# Use "groq" for cloud AI matching, or "disabled" to accept applications without AI processing.
AI_PROVIDER=disabled
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Global fallback chain. Task-specific chains below take precedence.
GROQ_MODEL_CHAIN=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b
GROQ_MATCH_MODEL_CHAIN=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b
GROQ_EXTRACTION_MODEL_CHAIN=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b
GROQ_SUMMARY_MODEL_CHAIN=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b
GROQ_TIMEOUT_MS=120000
AI_JOB_ATTEMPTS=6

# Public apply CV preview AI
# Uses Gemini only for pre-submit form suggestions. It does not affect Groq matching queues.
PREVIEW_AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_CHAIN=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3-flash,gemini-3.5-flash,gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=20000
GEMINI_QUOTA_COOLDOWN_MS=60000

# Document extraction is CPU/memory bound; keep this modest until benchmarked.
CV_EXTRACTION_CONCURRENCY=1
# Keep one Groq request at a time until account limits and CV sizes are benchmarked.
AI_MATCH_CONCURRENCY=1
POOL_EXTRACTION_CONCURRENCY=2
# Scanned PDFs and JPG/PNG CVs are processed locally with Tesseract vie+eng.
OCR_MAX_PAGES=10
OCR_MIN_CONFIDENCE=55
OCR_TIMEOUT_MS=120000

# Admin auth
ADMIN_EMAIL=v.bichlt6@vinsmartfuture.tech
ADMIN_PASSWORD=demo123
ADMIN_NAME=Lường Bích
JWT_ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=28800
JWT_REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-secret
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# CV storage
# Use "local" for a copy-pasteable local setup.
# Use "r2" for Cloudflare R2 private object storage in production/dev.
# "vercel-blob" remains supported for legacy Blob stores.
CV_STORAGE_DRIVER=local
# Optional. CVs belonging to archived jobs are moved to this secondary private storage tier.
CV_ARCHIVE_STORAGE_DRIVER=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=<bucket-name>
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
# Required for archived CV storage and reading legacy Vercel Blob paths.
BLOB_READ_WRITE_TOKEN=
# Required only for Vercel OIDC auth. Vercel sets this when the Blob store is connected to the project.
BLOB_STORE_ID=

# Email
# Gmail API over HTTPS (OAuth2). Sends from your @gmail account without SMTP
# ports, so it works on hosts that block SMTP (e.g. Render free tier).
# See docs/gmail-api-email-setup.md for how to obtain the OAuth2 refresh token.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_REPLY_TO=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Future providers
OPENAI_API_KEY=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
